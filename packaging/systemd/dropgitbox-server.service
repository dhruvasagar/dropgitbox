[Unit]
Description=dropgitbox server (git-backed folder sync)
Documentation=https://github.com/dhruvasagar/dropgitbox/blob/main/docs/deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/dropgitbox server --config /etc/dropgitbox/config.toml
Restart=on-failure
RestartSec=5

# Runs as an ephemeral system user; repositories live in /var/lib/dropgitbox.
DynamicUser=yes
StateDirectory=dropgitbox
StateDirectoryMode=0750
Environment=HOME=/var/lib/dropgitbox

# To serve HTTPS directly, pass the key in as a credential (it stays
# root-only on disk) with a drop-in (systemctl edit dropgitbox-server):
#   [Service]
#   LoadCredential=tls.crt:/etc/dropgitbox/tls/cert.pem
#   LoadCredential=tls.key:/etc/dropgitbox/tls/key.pem
# and in /etc/dropgitbox/config.toml:
#   tls_cert = "$CREDENTIALS_DIRECTORY/tls.crt"
#   tls_key  = "$CREDENTIALS_DIRECTORY/tls.key"
# Binding to a port below 1024 also needs:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
